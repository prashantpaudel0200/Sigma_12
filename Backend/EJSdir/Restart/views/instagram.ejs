<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        img{
            height: 100px;
            width: 150px;
        }
    </style>
</head>
<body>
    <h1>This page belongs to  @<%= data.name %></h1>
    <button>Follow</button>
    <button>Message</button>
    <p>Followers: <%= data.followers%>
       &nbsp; Following: <%= data.following%></p>

       <% for(let post of data.posts){ %>
        <img src="<%=post.image%>" alt="someImage">
        <p>Likes: <%= post.likes%>
       &nbsp; comments: <%= post.comments%></p>
       <%}%>
</body>
</html>

    
