<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Chats</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h1>Welcome to chat page</h1>

    <% for(let chat of chats) { %>

        <div class="chat">
            <p>From: <%= chat.from %>
            </p>
            <div class="msg">
                <p>
                    <%= chat.msg %>
                </p>
                <form method="GET" action="/chats/<%= chat.id%>/edit ">
                    <button class="edit">Edit message</button>
                </form>
                <form method="POST" action="/chats/<%= chat.id %>/delete?_method=DELETE">
                    <button class="delete">Delete Message</button>
                </form>
            </div>
            <p>Received by: <i>
                    <%= chat.to %>
                </i></p>
                <p> <%= chat.created_at.toString().split(" ")[4] %> </p>
                <p> <%= chat.created_at.toString().split(" ").slice(0, 4).join() %> </p>
        </div>
        

        <% } %>
            <form method="GET" action="chats/new">
                <button class="addMore">Add more</button>
            </form>
</body>

</html>